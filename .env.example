# Supabase project (Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog analytics. Leave empty to disable tracking (e.g. local development).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile site key. Leave empty to hide the CAPTCHA.
# Enable CAPTCHA in Supabase only AFTER a build with this key is deployed.
VITE_TURNSTILE_SITE_KEY=

# Set to "true" once the Google provider is enabled in Supabase Auth.
VITE_AUTH_GOOGLE=false
